[Unit]
Description=MIEAuth - Secure Two-Factor Authentication Server
Documentation=https://github.com/mieweb/mieweb_auth_app
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__HOME__/Builds/current
ExecStart=__HOME__/scripts/start-mieauth.sh
Restart=on-failure
RestartSec=10

# Environment is sourced via start-mieauth.sh wrapper
# which calls: source __HOME__/scripts/set-env.sh
# Edit ~/scripts/set-env.sh to change environment variables

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mieauth

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=__HOME__

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
