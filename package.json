    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.1",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.23",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.1",
