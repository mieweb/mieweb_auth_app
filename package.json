    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "axios": "^1.18.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^11.18.2",
    "get-port": "^7.1.0",
