# MIEWeb Auth Opensource — production instance, cut from `main`.
# Released by tags matching mie-os-prod-v*.
#
# The Android and iOS IDs differ for historical reasons: the Play listing was
# created as com.mieweb.mieauth while the App Store listing (and the
# mobile-config.js default) is org.mieweb.opensource.
ANDROID_APP_ID=com.mieweb.mieauth
IOS_APP_ID=org.mieweb.opensource
APP_NAME=MIEAuth
URL_SCHEME=mieauth
SERVER_URL=https://mieauth-prod.os.mieweb.org
PLAY_TRACK=internal
BRANCH=main
DEPLOY_MODE=ssh
SSH_HOST=mieauth-prod.os.mieweb.org
SSH_PORT=2000
SSH_USER=aabrol
# Profiles for this bundle ID already exist in the signing repo.
MATCH_READONLY=true
# Empty = keep the artwork committed in public/resources.
BRANDING_LOGO=
BRANDING_DIR=
BRANDING_WEB_LOGO=
