# MIEWeb Auth — MIE-internal instance, cut from `main`.
# Released by tags matching mie-v*. The server builds on the mie-fwdc-auth1
# self-hosted runner, so there is no SSH host here.
ANDROID_APP_ID=org.mieweb.auth
IOS_APP_ID=org.mieweb.auth
APP_NAME=MIEWeb Auth
URL_SCHEME=miewebauth
SERVER_URL=https://mieauth.mieweb.org
PLAY_TRACK=internal
BRANCH=main
DEPLOY_MODE=self-hosted
SSH_HOST=
SSH_PORT=
SSH_USER=
# org.mieweb.auth has no provisioning profile yet, so match must be allowed to
# create one. Flip to true once the first build has succeeded.
MATCH_READONLY=false
BRANDING_LOGO=branding/mieauth/logo.png
