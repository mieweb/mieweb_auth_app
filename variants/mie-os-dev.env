# MIEWeb Auth Opensource Beta — staging instance, cut from `development`.
# Released by tags matching mie-os-dev-v*.
ANDROID_APP_ID=org.mieweb.os.dev
IOS_APP_ID=org.mieweb.os.dev
APP_NAME=MIEAuth Beta
URL_SCHEME=mieauth
SERVER_URL=https://mieauth-dev.os.mieweb.org
PLAY_TRACK=internal
BRANCH=development
DEPLOY_MODE=ssh
SSH_HOST=mieauth-dev.os.mieweb.org
SSH_PORT=2010
SSH_USER=aabrol
# Profiles for this bundle ID already exist in the signing repo.
MATCH_READONLY=true
# Beta artwork, so the dev app is distinguishable from prod on the home screen.
# BRANDING_DIR is the generated-icon cache and must never be public/resources —
# that is the committed opensource artwork apply-variant.sh copies over.
BRANDING_LOGO=public/icon-beta.png
BRANDING_DIR=branding/os-dev/resources
# Beta rebrands only the app icons; the in-app web logo stays opensource, as it
# did under the old dev workflow.
BRANDING_WEB_LOGO=
