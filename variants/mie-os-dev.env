# MIEWeb Auth Opensource Beta — staging instance, cut from `development`.
# Released by tags matching mie-os-dev-v*.
ANDROID_APP_ID=org.mieweb.os.dev
IOS_APP_ID=org.mieweb.os.dev
APP_NAME=MIEAuth Beta
URL_SCHEME=mieauth
SERVER_URL=https://mieauth-dev.os.mieweb.org
PLAY_TRACK=internal
BRANCH=development
DEPLOY_MODE=ssh
SSH_HOST=mieauth-dev.os.mieweb.org
SSH_PORT=2010
SSH_USER=aabrol
# Profiles for this bundle ID already exist in the signing repo.
MATCH_READONLY=true
# Empty = keep the artwork committed in public/resources.
BRANDING_LOGO=
